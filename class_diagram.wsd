@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam ranksep 40
skinparam nodesep 40

class BankApp {
  -logger: Logger
  +main(args: String[]): void
  +runMenu(scanner: Scanner, out: PrintStream, account: Account): void
}

class User {
  -name: String
  -email: String
  +User(name: String, email: String)
  +getName(): String
  +setName(name: String): void
  +getEmail(): String
  +setEmail(email: String): void
}

class Account {
  -balance: double
  -database: Database
  -user: User
  -logger: Logger
  +Account(user: User, database: Database)
  +saveTransaction(amount: double, type: String): boolean
  +printStatement(): void
  +printStatement(out: PrintStream): void
  +getBalance(): double
  +setBalance(balance: double): void
  +getUser(): User
}

class Database {
  -connection: Connection
  -logger: Logger
  +Database()
  +Database(jdbcUrl: String)
  -createTransactionTable(): void
  +getConnection(): Connection
  +isConnected(): boolean
  +isTableCreated(tableName: String): boolean
  +close(): void
}

interface Operation {
  +execute(amount: double): void
}

class Deposit {
  -account: Account
  -logger: Logger
  +Deposit(account: Account)
  +execute(amount: double): void
}

class Withdrawal {
  -account: Account
  -logger: Logger
  +Withdrawal(account: Account)
  +execute(amount: double): void
}

class InvalidAmountException
class InsufficientBalanceException

class DateUtils {
  +YYYYMMDDHHMMSS_FORMATTER: DateTimeFormatter
  +formatDate(date: Timestamp): String
}

BankApp ..> Database : uses
BankApp ..> User : uses
BankApp ..> Account : uses
BankApp ..> Deposit : uses
BankApp ..> Withdrawal : uses

Account *-- User
Account *-- Database
Account ..> DateUtils : uses

Deposit ..|> Operation
Withdrawal ..|> Operation

Deposit *-- Account
Withdrawal *-- Account

InvalidAmountException --|> Exception
InsufficientBalanceException --|> Exception

Operation ..> InvalidAmountException : throws
Operation ..> InsufficientBalanceException : throws
Deposit ..> InvalidAmountException : throws
Withdrawal ..> InvalidAmountException : throws
Withdrawal ..> InsufficientBalanceException : throws

@enduml
